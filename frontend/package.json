{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fsd": "steiger ./src",
    "gen:client": "openapi-typescript ../backend/openapi.json -o src/shared/api/schema.d.ts",
    "format": "prettier --write src",
    "preview": "vite preview",
    "emoji:sync": "cp node_modules/emojibase-data/fr/data.json node_modules/emojibase-data/fr/messages.json public/emoji/fr/ && mkdir -p public/emoji/en && cp node_modules/emojibase-data/en/compact.json node_modules/emojibase-data/en/shortcodes/github.json public/emoji/en/"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-details": "^3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-mathematics": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "frimousse": "^0.3.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.14",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "emojibase-data": "^17.0.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.5",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
